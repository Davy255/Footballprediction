# ==============================================================
# PRODUCTION ENVIRONMENT VARIABLES (Backend)
# Set these in your Render / Railway / Cloud dashboard
# ==============================================================

# 1. Database Connection (PostgreSQL provided by Render / Neon / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 2. Security (Generate a secure 64-char hex key: openssl rand -hex 32)
SECRET_KEY=replace_with_a_long_random_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. External Football APIs
FOOTBALL_DATA_API_KEY=ce3ff4e6e3784c2798bb940ef9ef69d9
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
ODDS_API_KEY=0bd3aee3e6502b25b30cf2bf619c9525

# 4. CORS Allowed Origin (Your deployed Vercel URL)
FRONTEND_URL=https://your-frontend-project.vercel.app

# 5. Default Bootstrap Admin (Auto-created on first run)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# 6. Email Service (SMTP - Gmail, Brevo, Resend, or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_EMAIL=no-reply@footballpredict.com
SMTP_FROM_NAME=FootballPredict ⚽
SMTP_TLS=true

# ──────────────────────────────────────────────────────────────
# 7. Flutterwave Payment Gateway (Phase 2 — NOT ACTIVE YET)
#    Obtain keys from https://dashboard.flutterwave.com
# ──────────────────────────────────────────────────────────────

# ⚠️  SECURITY RULES — READ CAREFULLY:
#     FLUTTERWAVE_SECRET_KEY must NEVER be added to the frontend .env
#     NEVER use NEXT_PUBLIC_FLUTTERWAVE_SECRET_KEY — this exposes it to browsers!
#     The secret key is used ONLY server-side for webhook verification and API calls.

# Your Flutterwave Public Key (safe to use client-side if needed by SDK)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-replace-with-your-public-key

# Your Flutterwave Secret Key — SERVER-SIDE ONLY
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace-with-your-secret-key

# Webhook Secret — used to verify webhook signatures from Flutterwave
# Set this in your Flutterwave dashboard webhook settings
FLUTTERWAVE_WEBHOOK_SECRET=your-webhook-secret-hash

# Redirect URL after payment (your frontend success page)
FLUTTERWAVE_REDIRECT_URL=https://your-frontend.vercel.app/subscription/success
